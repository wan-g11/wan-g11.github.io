  <entry>
    <author>
      <name>wan_g</name>
    </author>
    <category term="技术" scheme="https://vvph.loc.cc/categories/%E6%8A%80%E6%9C%AF/"/>
    <category term="Git" scheme="https://vvph.loc.cc/tags/Git/"/>
